---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"
import barbell from "../assets/barbell.png";
import openrouter from "../assets/openrouter.svg";
import vue from "../assets/vue.svg";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-8 mt-5">
    <p class="text-lg leading-relaxed text-base-content/80">
      Full stack software engineer at Sentry Insurance working on customer-facing applications. Background in tech and finance. Outside of work, I lift, pole vault, and speedcube.
    </p>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5 flex items-center gap-3">
      <span class="h-8 w-1 bg-primary rounded-full"></span>
      My latest projects {"</>"}
    </div>
  </div>

  <div class="space-y-4">
    <HorizontalCard
      title="Lifting Log"
      img={barbell}
      desc="A full stack, authenticated web application to track lifting progress. Created with Next.js, Typescript, TailwindCSS, Clerk auth, and Drizzle ORM with Turso."
      url="https://liftinglog.app"
      badge="NEW"
    />
    <HorizontalCard
      title="Workout Generator"
      img={openrouter}
      desc="This application utilizes the OpenRouter API to generate workout routines for the user. Users can input their workout preferences, selecting from preset splits like push/pull/legs, body part splits, or specific muscles to target. Additionally, they can include notes for further customization."
      url="https://workout-generator-zeta.vercel.app"
    />
    <HorizontalCard
      title="Meeting Cost Calculator"
      img={vue}
      desc="A Vue3 application created to help users better understand the financial implications of their meetings. By inputting the salaries of participants and either setting a meeting duration or utilizing a timer, users can gain insights into the cost of their time spent in meetings."
      url="#"
    />
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10 flex items-center gap-3">
      <span class="h-8 w-1 bg-primary rounded-full"></span>
      Latest from blog
    </div>
  </div>

  <div class="space-y-4">
    {
      last_posts.map((post) => (
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.id)}
          target="_self"
          badge={post.data.badge}
        />
      ))
    }
  </div>
</BaseLayout>
