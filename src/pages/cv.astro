---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold flex items-center gap-3">
      <span class="h-8 w-1 bg-primary rounded-full"></span>
      Experience
    </div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="Software Engineer at Sentry Insurance"
      subtitle="From July 2025 to present"
    >
    </TimeLineElement>
    <TimeLineElement
      title="Software Developer at Sentry Insurance"
      subtitle="From May 2022 to July 2025"
    >
    </TimeLineElement>
    <TimeLineElement
      title="Associate Software Developer at Sentry Insurance"
      subtitle="From May 2021 to May 2022"
    >
    </TimeLineElement>
    <TimeLineElement
      title="Support Specialist Supervisor at DoIT Help Desk"
      subtitle="From May 2019 to May 2021"
    >
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold flex items-center gap-3">
      <span class="h-8 w-1 bg-primary rounded-full"></span>
      Education
    </div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="University of Wisconsin - Madison"
      subtitle="Bachelors, Computer Science, GPA: 3.8"
    />
    <TimeLineElement
      title="James Madison Memorial High School"
      subtitle="GPA: 3.97"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold flex items-center gap-3">
      <span class="h-8 w-1 bg-primary rounded-full"></span>
      Certifications
    </div>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold flex items-center gap-3">
      <span class="h-8 w-1 bg-primary rounded-full"></span>
      Skills
    </div>
  </div>

  <div class="mb-10 space-y-6">
    <!-- Front-End -->
    <div>
      <div class="text-lg font-semibold mb-3 text-primary/90">Front-End</div>
      <div class="flex flex-wrap gap-2">
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">React.js</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Next.js</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Angular</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Vue.js</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">TypeScript</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Tailwind CSS</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">React Native</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">JavaScript</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">HTML</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">CSS</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">SASS</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Three.js</span>
      </div>
    </div>

    <!-- Back-End -->
    <div>
      <div class="text-lg font-semibold mb-3 text-primary/90">Back-End</div>
      <div class="flex flex-wrap gap-2">
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Java</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Spring Boot</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Python</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">C#</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">C</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">VB.NET</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Node.js</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Express.js</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">.NET Framework</span>
      </div>
    </div>

    <!-- Databases -->
    <div>
      <div class="text-lg font-semibold mb-3 text-primary/90">Databases</div>
      <div class="flex flex-wrap gap-2">
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Microsoft SQL Server</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">MySQL</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">SQLite</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Turso</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Drizzle ORM</span>
      </div>
    </div>
    
    <!-- DevOps & Tools -->
    <div>
      <div class="text-lg font-semibold mb-3 text-primary/90">DevOps & Tools</div>
      <div class="flex flex-wrap gap-2">
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Dynatrace</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">ELK Stack</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Jira</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">SoapUI</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Linux</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Google Analytics</span>
      </div>
    </div>

    <!-- Additional Tools -->
    <div>
      <div class="text-lg font-semibold mb-3 text-primary/90">Additional Tools</div>
      <div class="flex flex-wrap gap-2">
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Adobe Creative Suite</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Video Editing</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Microsoft Office</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Cherwell Service Management</span>
      </div>
    </div>

    <!-- Soft Skills & Languages -->
    <div>
      <div class="text-lg font-semibold mb-3 text-primary/90">Soft Skills & Languages</div>
      <div class="flex flex-wrap gap-2">
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Leadership</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Communication</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Public Speaking</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Technical Support</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Customer Support</span>
        <span class="badge badge-outline border-base-300 bg-base-200 text-base-content/90 py-3 px-4">Spanish</span>
      </div>
    </div>
  </div>
</BaseLayout>
