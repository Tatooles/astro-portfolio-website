    <h1 class="text-9xl font-bold mb-4">🏝</h1>
    <h1 class="text-9xl font-bold mb-2 text-white">404</h1>
    <h3 class="text-2xl text-base-content/70">The page you're looking for couldn't be found.</h3>
    <a class="btn btn-primary mt-9" href="/">Home</a>
  </div>
</BaseLayout>
