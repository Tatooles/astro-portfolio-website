---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
---

<div class="md:w-1/3 w-full">
  <a href={url} target={target}>
    <div class="card bg-base-200 border border-base-300 hover:border-primary/40 hover:shadow-lg hover:shadow-primary/5 transition-all duration-300 mx-6 my-2">
      <Image width={750} height={422} format="webp" src={img} alt={title} class="rounded-t-2xl" />
      <div class="card-body">
        <h2 class="card-title text-white">
          {title}
          {badge && <div class="badge badge-secondary badge-sm font-medium">{badge}</div>}
        </h2>
        <p class="text-base-content/70">{desc}</p>
        <div class="card-actions justify-end">
          {tags && tags.map((tag: any) => <div class="badge badge-outline badge-sm border-primary/30 text-primary/80">{tag}</div>)}
        </div>
      </div>
    </div>
  </a>
</div>

