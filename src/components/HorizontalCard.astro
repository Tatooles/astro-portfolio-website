---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<div
  class="rounded-lg bg-base-200 border border-base-300 hover:border-primary/40 hover:shadow-lg hover:shadow-primary/5 transition-all duration-300"
>
  <a href={url} target={target}>
    <div class="hero-content flex-col md:flex-row p-5">
      {
        img && (
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold text-white">
          {title}
          {badge && <div class="badge badge-secondary badge-sm mx-2 font-medium">{badge}</div>}
        </h1>
        <p class="py-1 text-base text-base-content/70 leading-relaxed">{desc}</p>
        <div class="card-actions justify-end mt-1">
          {
            tags &&
              tags.map((tag: any) => (
                <a href={`${tag_url}/${tag}`} class="badge badge-outline badge-sm border-primary/30 text-primary/80 hover:bg-primary/10">
                  {tag}
                </a>
              ))
          }
        </div>
      </div>
    </div>
  </a>
</div>
