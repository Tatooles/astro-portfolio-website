---
const { sideBarActiveItemID } = Astro.props;
const activeClass = "sidebar-active";
---

<ul class="menu grow shrink menu-md overflow-y-auto px-3">
    <li><a class="py-3 text-base rounded-lg transition-all duration-200 hover:bg-base-300 hover:text-primary" id="home" href="/">Home</a></li>
    <li><a class="py-3 text-base rounded-lg transition-all duration-200 hover:bg-base-300 hover:text-primary" id="projects" href="/projects">Projects</a></li>
    <li><a class="py-3 text-base rounded-lg transition-all duration-200 hover:bg-base-300 hover:text-primary" id="blog" href="/blog/">Blog</a></li>
    <li><a class="py-3 text-base rounded-lg transition-all duration-200 hover:bg-base-300 hover:text-primary" id="cv" href="/cv">CV</a></li>
    <li>
        <a
            class="py-3 text-base rounded-lg transition-all duration-200 hover:bg-base-300 hover:text-primary"
            href="mailto:kevintatooles@gmail.com"
            target="_blank"
            referrerpolicy="no-referrer-when-downgrade">Contact</a
        >
    </li>
</ul>

<script define:vars={{ sideBarActiveItemID: sideBarActiveItemID, activeClass: activeClass }}>
const activeItemElem = document.getElementById(sideBarActiveItemID);
if (activeItemElem) {
    activeItemElem.classList.add(activeClass);
}
</script>

<style>
    :global(.sidebar-active) {
        background-color: oklch(var(--b3));
        color: oklch(var(--p));
        border-left: 3px solid oklch(var(--p));
    }
</style>
